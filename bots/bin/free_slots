#!/usr/bin/env python3
"""Preflight for a local model server: is a slot free right now?

    bots/bin/free_slots [URL]     # default http://127.0.0.1:8080/slots

Exit 0 = at least one idle slot (or the server does not expose /slots, which is
not evidence of saturation). Exit 3 = every slot busy, so a bot should skip this
cycle rather than queue behind in-flight work. Used as a model alias's
`preflight` in bots/models.yml; llama-server and vLLM both serve /slots.
"""
from __future__ import annotations

import json
import sys
import urllib.error
import urllib.request

DEFAULT_URL = "http://127.0.0.1:8080/slots"


def main() -> int:
    url = sys.argv[1] if len(sys.argv) > 1 else DEFAULT_URL
    try:
        with urllib.request.urlopen(url, timeout=5) as response:
            slots = json.loads(response.read().decode("utf-8", "replace"))
    except (urllib.error.URLError, TimeoutError, json.JSONDecodeError, OSError) as exc:
        # No /slots endpoint (or no server): let the real call decide.
        print(f"slots unknown at {url}: {exc}", file=sys.stderr)
        return 0

    if not isinstance(slots, list):
        print(f"slots unknown at {url}: unexpected payload", file=sys.stderr)
        return 0

    free = sum(1 for slot in slots if not slot.get("is_processing"))
    print(f"{free}/{len(slots)} slots free at {url}")
    return 0 if free else 3


if __name__ == "__main__":
    raise SystemExit(main())
