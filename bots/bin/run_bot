#!/usr/bin/env python3
"""Run a bot through the dashboard, or explicitly in dry-run/ephemeral mode."""

from __future__ import annotations

import argparse
import json
import pathlib
import sys

BOTS_ROOT = pathlib.Path(__file__).resolve().parents[1]
sys.path.insert(0, str(BOTS_ROOT))

import bot_runner
import providers


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("bot", nargs="?", help="bot name (directory under bots/)")
    parser.add_argument("--list", action="store_true", help="list defined bots")
    modes = parser.add_mutually_exclusive_group()
    modes.add_argument("--dry-run", action="store_true", help="build and print the prompt only")
    modes.add_argument(
        "--ephemeral",
        action="store_true",
        help="invoke the model without persisting provider state",
    )
    parser.add_argument("--model", help="override the bot model alias")
    parser.add_argument("--models-config", help="alternative models.yml")
    args = parser.parse_args()

    if args.list:
        models_cfg = bot_runner.load_models(args.models_config)
        for path in bot_runner.discover():
            cfg = bot_runner.load_bot(path)
            state = "enabled" if cfg.get("enabled", True) else "disabled"
            aliases = " -> ".join(bot_runner._model_aliases(cfg, models_cfg))
            print(
                f"{cfg['name']:<20} {cfg['schedule']:<16} model={aliases} "
                f"[{state}] {cfg.get('description', '')}"
            )
        return 0

    if not args.bot:
        parser.error("name a bot, or pass --list")
    try:
        cfg = bot_runner.load_bot(BOTS_ROOT / args.bot)
        result = bot_runner.run(
            cfg,
            dry_run=args.dry_run,
            ephemeral=args.ephemeral,
            models_config=args.models_config,
            model_override=args.model,
        )
    except (bot_runner.BotError, providers.ProviderFailure) as exc:
        print(f"{args.bot}: {getattr(exc, 'code', type(exc).__name__)}", file=sys.stderr)
        return 1
    if args.dry_run:
        print(result.debug_prompt or "")
    else:
        print(json.dumps(result.projection, sort_keys=True))
    if result.outcome == "capacity_unavailable":
        return 3
    return 1 if result.outcome in {"failed", "timed_out"} else 0


if __name__ == "__main__":
    raise SystemExit(main())
