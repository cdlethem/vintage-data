#!/usr/bin/env python3
"""Run raw-source synchronization with the shared transform environment."""

from __future__ import annotations

import os
import pathlib
import subprocess

PROJECT_DIR = pathlib.Path(__file__).resolve().parents[1]
REPO_ROOT = PROJECT_DIR.parent


def main() -> None:
    try:
        common_dir = subprocess.run(
            ["git", "rev-parse", "--path-format=absolute", "--git-common-dir"],
            cwd=REPO_ROOT,
            check=True,
            capture_output=True,
            text=True,
        ).stdout.strip()
    except (OSError, subprocess.CalledProcessError) as exc:
        raise SystemExit(f"cannot resolve the shared checkout: {exc}") from exc
    common_path = pathlib.Path(common_dir)
    shared_root = common_path.parent if common_path.name == ".git" else common_path
    python = shared_root / "transform" / ".venv" / "bin" / "python"
    if not python.is_file():
        raise SystemExit(
            "transform environment is missing; run orchestration/setup/07_transform.sh"
        )
    script = PROJECT_DIR / "scripts" / "sync_raw_sources.py"
    os.execv(str(python), [str(python), str(script), *os.sys.argv[1:]])


if __name__ == "__main__":
    main()
