#!/usr/bin/env python3
"""Run the shared transform venv against this checkout's dbt project."""

from __future__ import annotations

import os
import pathlib
import subprocess
import sys
import time

PROJECT_DIR = pathlib.Path(__file__).resolve().parents[1]
REPO_ROOT = PROJECT_DIR.parent


def _shared_checkout() -> pathlib.Path:
    try:
        common_dir = subprocess.run(
            [
                "git",
                "rev-parse",
                "--path-format=absolute",
                "--git-common-dir",
            ],
            cwd=REPO_ROOT,
            check=True,
            capture_output=True,
            text=True,
        ).stdout.strip()
    except (OSError, subprocess.CalledProcessError) as exc:
        raise SystemExit(f"cannot resolve the shared checkout: {exc}") from exc
    path = pathlib.Path(common_dir)
    return path.parent if path.name == ".git" else path


def _option_value(arguments: list[str], option: str) -> str | None:
    for index, argument in enumerate(arguments):
        if argument == option and index + 1 < len(arguments):
            return arguments[index + 1]
        if argument.startswith(f"{option}="):
            return argument.split("=", 1)[1]
    return None


def main() -> None:
    shared_root = _shared_checkout()
    sys.path.insert(0, str(shared_root / "orchestration" / "include"))
    try:
        import deployment
    except ImportError as exc:
        raise SystemExit(f"cannot load deployment environment: {exc}") from exc

    deployment.load_env()
    deployment.load_env(shared_root / "orchestration" / "airflow.secrets.env")
    arguments = sys.argv[1:]
    project_dir = pathlib.Path(_option_value(arguments, "--project-dir") or PROJECT_DIR)
    os.environ.setdefault(
        "DBT_DEV_WAREHOUSE", str(project_dir / "target" / "dev.duckdb")
    )

    executable = shared_root / "transform" / ".venv" / "bin" / "dbt"
    if not executable.is_file():
        raise SystemExit(
            "transform dbt environment is missing; run "
            "orchestration/setup/07_transform.sh"
        )
    if arguments and arguments[0] in {"--help", "--version", "-h", "-V"}:
        argv = [str(executable), *arguments]
    else:
        argv = [str(executable), *arguments]
        if _option_value(arguments, "--project-dir") is None:
            argv.extend(["--project-dir", str(PROJECT_DIR)])
        if _option_value(arguments, "--profiles-dir") is None:
            argv.extend(["--profiles-dir", str(project_dir)])
    deadline = time.monotonic() + 120
    delay = 0.5
    while True:
        result = subprocess.run(
            argv,
            cwd=project_dir,
            env=os.environ,
            capture_output=True,
            text=True,
            check=False,
        )
        combined = result.stdout + result.stderr
        locked = (
            "Could not set lock on file" in combined
            and "Conflicting lock" in combined
        )
        model_started = " START " in combined
        if result.returncode == 0 or not locked or model_started:
            sys.stdout.write(result.stdout)
            sys.stderr.write(result.stderr)
            raise SystemExit(result.returncode)
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            sys.stdout.write(result.stdout)
            sys.stderr.write(result.stderr)
            raise SystemExit(result.returncode)
        sys.stderr.write(
            f"dbt warehouse lock is busy; retrying before model execution "
            f"in {min(delay, remaining):g}s\n"
        )
        time.sleep(min(delay, remaining))
        delay = min(delay * 2, 10.0)


if __name__ == "__main__":
    main()
