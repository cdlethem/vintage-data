#!/usr/bin/env python3
"""Run checkout-local visualization code with a provisioned, pinned interpreter."""
import os
import pathlib
import subprocess
import sys

root = pathlib.Path(__file__).resolve().parents[1]
executable = pathlib.Path(os.environ.get('VINTAGE_VISUALIZATION_PYTHON', root / '.venv/bin/python'))
if not executable.is_file() and not os.environ.get('VINTAGE_VISUALIZATION_PYTHON'):
    # Git worktrees share dependencies, but always execute their own code.
    try:
        common = subprocess.check_output(['git', 'rev-parse', '--path-format=absolute', '--git-common-dir'], cwd=root, text=True, stderr=subprocess.DEVNULL).strip()
        shared = pathlib.Path(common)
        if shared.name == '.git':
            executable = shared.parent / 'visualization/.venv/bin/python'
    except (OSError, subprocess.CalledProcessError):
        pass
if not executable.is_file():
    raise SystemExit('Visualization environment missing: run setup/08_lightdash.sh or provision the locked requirements and set VINTAGE_VISUALIZATION_PYTHON.')
os.execv(str(executable), [str(executable), str(root / 'cli.py'), *sys.argv[1:]])
