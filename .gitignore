# Source-discovery working directory (LLM vetting harness) — not project code.
# Vetted scripts are promoted by copying into pipelines/extract/scripts/.
possible_sources/

# Staging area for vetted fetch_*.py scripts awaiting promotion/scheduling —
# not project code either; same promotion path as above.
staged_scripts/

# Raw output of the discovery harness (candidate/vetting JSON) — working data,
# not project code; anything worth keeping is promoted into
# pipelines/extract/catalogs/.
discovery/

# Airflow runtime state (config, logs, generated passwords)
orchestration/airflow_home/
orchestration/.venv/
pipelines/load/.venv/

# Secrets — airflow.secrets.env.example is the checked-in template
orchestration/airflow.secrets.env

__pycache__/
*.pyc
