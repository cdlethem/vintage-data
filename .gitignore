# Machine-local configuration. Everything path-, host- or account-specific
# lives in these two files; every other tracked file is portable.
# (copy them from config.example.env / bots/models.example.yml)
orchestration/config.env
bots/models.yml

# Generated from the files above by orchestration/setup/render_config.sh
orchestration/airflow.env
orchestration/generated/

# Secrets — airflow.secrets.env.example is the checked-in template
orchestration/airflow.secrets.env

# Airflow runtime state (config, logs, generated passwords) and virtualenvs
orchestration/airflow_home/
orchestration/.venv/
load/.venv/

# Bot run output
bots/runs/

# Source-discovery workbench: the vetting harness, its evidence trail, and the
# raw candidate JSON it emits. discovery/staged_scripts/ IS tracked: those are
# vetted fetchers awaiting promotion into extract/.
discovery/possible_sources/
discovery/*.json
discovery/*.ndjson

__pycache__/
*.pyc
.ruff_cache/

# dbt transform runtime and generated artifacts
transform/.venv/
transform/target/
transform/logs/
transform/dbt_packages/

# Lightdash dependencies, local CLI state and generated serving bundles
visualization/.venv/
visualization/node_modules/
**/.lightdash-metadata.json
**/.lightdash/

# Provider UI dependencies and local Python build outputs
node_modules/
orchestration/provider_bot_dashboard/dist/
orchestration/provider_bot_dashboard/build/
*.egg-info/
transform/.user.yml
