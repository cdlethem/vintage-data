[Unit]
Description=Vintage OpenAI-compatible model gateway (optional OMP bridge)
After=vintage-model-broker.service
Requires=vintage-model-broker.service

[Service]
Environment=OMP_AUTH_BROKER_URL=http://@BOT_MODEL_BROKER_BIND@
ExecStart=@BOT_DASHBOARD_OMP_EXECUTABLE@ auth-gateway serve --bind=@BOT_MODEL_GATEWAY_BIND@
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=default.target
