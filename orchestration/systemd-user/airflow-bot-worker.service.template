[Unit]
Description=Vintage confined bot execution worker

[Service]
EnvironmentFile=@PROJECT_ROOT@/orchestration/airflow.env
EnvironmentFile=@PROJECT_ROOT@/orchestration/airflow.secrets.env
Environment=PATH=@SERVICE_PATH@
Environment=AIRFLOW__LOGGING__WORKER_LOG_SERVER_PORT=8799
WorkingDirectory=@PROJECT_ROOT@/orchestration
ExecStart=@PROJECT_ROOT@/orchestration/.venv/bin/airflow celery worker --celery-hostname bot-worker --queues bot_dashboard_executor --autoscale 16,2
Restart=on-failure
RestartSec=5
KillMode=mixed
TimeoutStopSec=3000

[Install]
WantedBy=default.target
