[Unit]
Description=Airflow celery worker %i
After=network.target postgresql.service redis-server.service airflow-api-server.service
Wants=postgresql.service redis-server.service

[Service]
User=colin
Group=colin
EnvironmentFile=/home/colin/dev/extract/orchestration/airflow.env
EnvironmentFile=/home/colin/dev/extract/orchestration/airflow.secrets.env
# Each worker instance serves task logs on its own port (8791, 8792, ...);
# with one shared default (8793) the second instance loses the bind race.
Environment=AIRFLOW__LOGGING__WORKER_LOG_SERVER_PORT=879%i
WorkingDirectory=/home/colin/dev/extract/orchestration
ExecStart=/home/colin/dev/extract/orchestration/.venv/bin/airflow celery worker --celery-hostname worker-%i
Restart=on-failure
RestartSec=5
# Give SIGTERM warm shutdown time to finish in-flight tasks before SIGKILL.
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
