[Unit]
Description=Verify and deploy merged vintage-data main to local Airflow
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
# Only the reviewed release script runs as the unprivileged service user. The
# root-owned unit contains the fixed privileged restart/rollback sequence.
ExecStart=/bin/sh -c 'restart_runtime() { /usr/bin/systemctl restart airflow-api-server.service airflow-scheduler.service airflow-dag-processor.service && /usr/bin/systemctl try-restart "airflow-worker@*.service" || return 1; uid=$$(/usr/bin/id -u @SERVICE_USER@); if /usr/bin/runuser -u @SERVICE_USER@ -- /usr/bin/env XDG_RUNTIME_DIR=/run/user/$$uid /usr/bin/systemctl --user is-active --quiet airflow-bot-worker.service; then /usr/bin/runuser -u @SERVICE_USER@ -- /usr/bin/env XDG_RUNTIME_DIR=/run/user/$$uid /usr/bin/systemctl --user restart airflow-bot-worker.service || return 1; fi; }; /usr/bin/runuser -u @SERVICE_USER@ -- /usr/bin/python3 @PROJECT_ROOT@/orchestration/deploy/sync.py deploy; result=$$?; if [ "$$result" -eq 0 ]; then exit 0; fi; if [ "$$result" -ne 10 ]; then exit "$$result"; fi; if restart_runtime; then exit 0; fi; echo "restart failed; reverting release" >&2; /usr/bin/runuser -u @SERVICE_USER@ -- /usr/bin/python3 @PROJECT_ROOT@/orchestration/deploy/sync.py rollback; rolled=$$?; if [ "$$rolled" -ne 10 ]; then exit 1; fi; restart_runtime || exit 1; exit 1'
TimeoutStartSec=90min

[Install]
WantedBy=multi-user.target
