[Unit]
Description=Airflow celery worker %i
After=network.target postgresql.service redis-server.service airflow-api-server.service
Wants=postgresql.service redis-server.service

[Service]
User=@SERVICE_USER@
Group=@SERVICE_GROUP@
EnvironmentFile=@PROJECT_ROOT@/orchestration/airflow.env
EnvironmentFile=@PROJECT_ROOT@/orchestration/airflow.secrets.env
# Each worker instance serves task logs on its own port (8791, 8792, ...);
# with one shared default (8793) the second instance loses the bind race.
Environment=AIRFLOW__LOGGING__WORKER_LOG_SERVER_PORT=879%i
# Bots run as Airflow tasks and may shell out to a CLI model provider, which
# systemd's minimal PATH would not find.
Environment=PATH=@SERVICE_PATH@
WorkingDirectory=@PROJECT_ROOT@/orchestration
ExecStart=@PROJECT_ROOT@/orchestration/.venv/bin/airflow celery worker --celery-hostname worker-%i
Restart=on-failure
RestartSec=5
# Give SIGTERM warm shutdown time to finish in-flight tasks before SIGKILL.
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
