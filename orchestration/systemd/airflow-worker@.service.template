[Unit]
Description=Airflow celery worker %i
After=network.target postgresql.service redis-server.service airflow-api-server.service
Wants=postgresql.service redis-server.service

[Service]
User=@SERVICE_USER@
Group=@SERVICE_GROUP@
EnvironmentFile=@PROJECT_ROOT@/orchestration/airflow.env
EnvironmentFile=@PROJECT_ROOT@/orchestration/airflow.secrets.env
# Each worker instance serves task logs on its own port (8791, 8792, ...);
# with one shared default (8793) the second instance loses the bind race.
Environment=AIRFLOW__LOGGING__WORKER_LOG_SERVER_PORT=879%i
# Task subprocesses need the service user's tool path; systemd's minimal
# PATH would not find it.
Environment=PATH=@SERVICE_PATH@
WorkingDirectory=@PROJECT_ROOT@/orchestration
ExecStart=@PROJECT_ROOT@/orchestration/.venv/bin/airflow celery worker --celery-hostname worker-%i
Restart=on-failure
RestartSec=5
# SIGTERM must reach only the worker's main process so celery's warm shutdown
# can drain in-flight tasks. The default KillMode=control-group also signals
# task subprocesses directly, killing mid-run extracts with no summary line.
KillMode=mixed
# Warm-shutdown budget: the longest task (120 min execution_timeout) plus
# margin, after which systemd SIGKILLs whatever is left in the cgroup.
TimeoutStopSec=135min

[Install]
WantedBy=multi-user.target
