# Non-secret Airflow configuration, shared by every component (systemd units
# load this plus airflow.secrets.env). Config lives here as env vars so
# airflow_home/airflow.cfg stays generated-only and out of git.
AIRFLOW_HOME=/home/colin/dev/extract/orchestration/airflow_home
AIRFLOW__CORE__EXECUTOR=CeleryExecutor
AIRFLOW__CORE__DAGS_FOLDER=/home/colin/dev/extract/orchestration/dags
AIRFLOW__CORE__LOAD_EXAMPLES=False
AIRFLOW__CORE__DEFAULT_TIMEZONE=utc
AIRFLOW__CORE__SIMPLE_AUTH_MANAGER_USERS=admin:admin
# 8080 and 8081 are taken by llama-server on this host; UI binds loopback only and is published via tailscale serve.
AIRFLOW__API__HOST=127.0.0.1
AIRFLOW__API__PORT=8082
AIRFLOW__API__BASE_URL=http://localhost:8082
AIRFLOW__CELERY__BROKER_URL=redis://localhost:6379/0
# result_backend intentionally unset: it falls back to the metadata DB.
AIRFLOW__CELERY__WORKER_CONCURRENCY=4
PYTHONPATH=/home/colin/dev/extract/orchestration/include
# Where sinks.LocalSink lands data — outside the repo.
EXTRACT_DATA_ROOT=/home/colin/dev/data/extract
