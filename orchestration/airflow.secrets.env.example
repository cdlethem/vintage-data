# Template for airflow.secrets.env (gitignored).
# setup/02_database.sh generates the real file with fresh values.
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://airflow:CHANGE_ME@localhost:5432/airflow
# Must be identical across all components or worker auth to the api-server fails.
AIRFLOW__API_AUTH__JWT_SECRET=CHANGE_ME
BOT_DASHBOARD_API_PASSWORD=CHANGE_ME
