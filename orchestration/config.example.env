# Machine-local configuration — the only file that knows about *this* host.
#
#   cp orchestration/config.example.env orchestration/config.env
#   $EDITOR orchestration/config.env
#   orchestration/setup/setup.sh
#
# config.env is gitignored. Everything path- or host-bound is rendered from it:
# orchestration/airflow.env and every systemd unit (see setup/render_config.sh).
# This file is sourced by bash, so $HOME, $(id -un) and ${VAR} all work.
#
# Nothing here is a secret. Credentials live in orchestration/airflow.secrets.env,
# which setup/02_database.sh generates and never commits.

# --- service account -------------------------------------------------------
# The user systemd runs Airflow, the loader, and the monitor as. Must own the
# repo, the data root, and the virtualenvs.
SERVICE_USER="$(id -un)"
SERVICE_GROUP="$(id -gn)"

# --- data locations (deliberately outside the repo) ------------------------
# The extract sink: raw NDJSON, hive-partitioned as source=<name>/dt=<date>.
EXTRACT_DATA_ROOT="$HOME/.local/share/vintage-data/extract"
# The warehouse the load layer writes to. Used by the duckdb destination; a
# cloud destination ignores it (see "Swapping infrastructure" in the README).
EXTRACT_WAREHOUSE="$HOME/.local/share/vintage-data/warehouse/extract.duckdb"
# Filesystem queue between the load DAG and the writer service.
EXTRACT_LOAD_QUEUE="$EXTRACT_DATA_ROOT/_load_queue"

# --- extract behaviour -----------------------------------------------------
# Which sink implementation the runner uses (orchestration/include/sinks.py).
EXTRACT_SINK=local
# Sent by every fetcher. Several sources (Crossref, MusicBrainz, NCBI, OSM)
# ask for a real contact and rate-limit anonymous traffic harder: put your own
# address or project URL here before running a full schedule.
EXTRACT_USER_AGENT="vintage-data/0.1 (+https://github.com/cdlethem/vintage-data)"

# --- warehouse tuning (duckdb destination) ---------------------------------
EXTRACT_WAREHOUSE_THREADS=4
EXTRACT_WAREHOUSE_MEMORY_LIMIT=6GB

# --- Airflow ---------------------------------------------------------------
# The UI binds this host only; publish it deliberately (see PUBLISH_TAILSCALE).
AIRFLOW_API_HOST=127.0.0.1
# 8080/8081 are often taken by a local model server; 8082 avoids that clash.
AIRFLOW_API_PORT=8082
AIRFLOW_API_BASE_URL="http://localhost:${AIRFLOW_API_PORT}"
# simple_auth_manager users, "name:role". The password is generated on first
# api-server start into airflow_home/simple_auth_manager_passwords.json.generated.
AIRFLOW_ADMIN_USERS=admin:admin
# Internal bot tasks authenticate through this least-privilege Simple Auth user.
BOT_DASHBOARD_API_USERNAME=bot-worker
# Authenticated human task controls; automated execution has separate gates.
BOT_DASHBOARD_WRITE_ENABLED=False
BOT_DASHBOARD_ALLOW_SIMPLE_AUTH_WRITES=False
# Celery worker instances (airflow-worker@1 … @N) and slots per worker.
AIRFLOW_WORKERS=2
AIRFLOW_WORKER_CONCURRENCY=4
CELERY_BROKER_URL=redis://localhost:6379/0

# --- Airflow metadata database --------------------------------------------
# setup/02_database.sh creates this role and database locally and writes the
# generated password into airflow.secrets.env. Point it at a managed Postgres
# by editing airflow.secrets.env afterwards; nothing else reads these.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=airflow
POSTGRES_ROLE=airflow

# --- monitoring ------------------------------------------------------------
# The monitor's model step is an *assessor program*: it reads a prompt on
# stdin and writes a markdown report to stdout. Leave empty to run triage only
# (deterministic, no model). Two ready-made ones ship in monitoring/assessors/:
#   MONITOR_ASSESSOR="$PWD/../monitoring/assessors/openrouter.sh"   # needs OPENROUTER_API_KEY
#   MONITOR_ASSESSOR="$PWD/../monitoring/assessors/omp.sh"          # local omp CLI
MONITOR_ASSESSOR=""
# Hours of sink history each check considers.
MONITOR_WINDOW_HOURS=24
# PATH for the monitor unit. systemd's default omits ~/.local/bin, where
# pipx/uv/omp-style tools install.
MONITOR_PATH="$HOME/.local/bin:/usr/local/bin:/usr/bin:/bin"

# --- optional network publishing ------------------------------------------
# 1 = run `tailscale serve` for the UI during setup. 0 = leave it loopback-only.
PUBLISH_TAILSCALE=0

# --- Lightdash (optional, open source Docker Compose stack) -----------------
# Set 1 before running setup/08_lightdash.sh to start services and publish
# completed production marts. Validation/content tools work while disabled.
LIGHTDASH_ENABLED=0
LIGHTDASH_STATE_ROOT="$HOME/.local/share/vintage-data/lightdash"
LIGHTDASH_HOST=127.0.0.1
LIGHTDASH_PORT=8083
LIGHTDASH_URL="http://localhost:${LIGHTDASH_PORT}"
# Tailnet-only HTTPS port created by setup/05_tailscale.sh.
LIGHTDASH_TAILSCALE_HTTPS_PORT=8083
LIGHTDASH_PG_HOST=127.0.0.1
LIGHTDASH_PG_PORT=5433
LIGHTDASH_SERVING_DB=vintage_serving
LIGHTDASH_SECURE_COOKIES=false
LIGHTDASH_TRUST_PROXY=false
