# Non-secret Airflow configuration, shared by every component (systemd units
# load this plus airflow.secrets.env). Config lives here as env vars so
# airflow_home/airflow.cfg stays generated-only and out of git.
#
# GENERATED from this template by setup/render_config.sh. Edit
# orchestration/config.env and re-render; never edit airflow.env by hand.
AIRFLOW_HOME=@PROJECT_ROOT@/orchestration/airflow_home
AIRFLOW__CORE__EXECUTOR=CeleryExecutor
AIRFLOW__CORE__DAGS_FOLDER=@PROJECT_ROOT@/orchestration/dags
AIRFLOW__CORE__LOAD_EXAMPLES=False
AIRFLOW__CORE__DEFAULT_TIMEZONE=utc
AIRFLOW__CORE__SIMPLE_AUTH_MANAGER_USERS="@AIRFLOW_SIMPLE_AUTH_USERS@"
AIRFLOW__API__HOST="@AIRFLOW_API_HOST@"
AIRFLOW__API__PORT="@AIRFLOW_API_PORT@"
AIRFLOW__API__BASE_URL="@AIRFLOW_API_BASE_URL@"
AIRFLOW__CELERY__BROKER_URL="@CELERY_BROKER_URL@"
# result_backend intentionally unset: it falls back to the metadata DB.
AIRFLOW__CELERY__WORKER_CONCURRENCY="@AIRFLOW_WORKER_CONCURRENCY@"
PYTHONPATH=@PROJECT_ROOT@/orchestration/include
# airflow-bots: see bots/README.md. The live config sits with the data, outside git,
# because the Bots page in the Airflow UI edits it; prompts and evals stay tracked.
BOTS_CONFIG=@EXTRACT_DATA_ROOT@/state/bots/config.yml
VINTAGE_BOTS_DIR=@PROJECT_ROOT@/orchestration/bots
BOTS_API_USERNAME="@BOTS_API_USERNAME@"
# Which sink implementation extract output lands through (include/sinks.py).
EXTRACT_SINK="@EXTRACT_SINK@"
# Sent by every fetcher; several sources rate-limit anonymous traffic harder.
EXTRACT_USER_AGENT="@EXTRACT_USER_AGENT@"
# Where sinks.LocalSink lands data — outside the repo.
EXTRACT_DATA_ROOT="@EXTRACT_DATA_ROOT@"
# Load layer. Read by the DAG and by extract-loader.service,
# and interpolated into load/config/load.yml.
EXTRACT_WAREHOUSE="@EXTRACT_WAREHOUSE@"
EXTRACT_LOAD_QUEUE="@EXTRACT_LOAD_QUEUE@"
EXTRACT_WAREHOUSE_THREADS="@EXTRACT_WAREHOUSE_THREADS@"
EXTRACT_WAREHOUSE_MEMORY_LIMIT="@EXTRACT_WAREHOUSE_MEMORY_LIMIT@"
LIGHTDASH_ENABLED="@LIGHTDASH_ENABLED@"
LIGHTDASH_STATE_ROOT="@LIGHTDASH_STATE_ROOT@"
LIGHTDASH_HOST="@LIGHTDASH_HOST@"
LIGHTDASH_PORT="@LIGHTDASH_PORT@"
LIGHTDASH_URL="@LIGHTDASH_URL@"
LIGHTDASH_PG_HOST="@LIGHTDASH_PG_HOST@"
LIGHTDASH_PG_PORT="@LIGHTDASH_PG_PORT@"
LIGHTDASH_SERVING_DB="@LIGHTDASH_SERVING_DB@"
LIGHTDASH_SECURE_COOKIES="@LIGHTDASH_SECURE_COOKIES@"
LIGHTDASH_TRUST_PROXY="@LIGHTDASH_TRUST_PROXY@"
