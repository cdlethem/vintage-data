[Unit]
Description=Run the extract pipeline sanity check every 30 minutes

[Timer]
# First run 5min after boot, then every 30min. Cheap when healthy (triage
# only, no model call); the model runs solely when a source is flagged.
OnBootSec=5min
OnUnitActiveSec=30min
Persistent=true

[Install]
WantedBy=timers.target
